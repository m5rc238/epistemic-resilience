---
import SysScene from './SysScene.astro';

/** Six phases form a cycle: outcomes become new evidence. The nodes stay
 *  fixed around a circle, while the explanatory copy sits below it. */
const ring = [
	{ kind: 'evidence', label: 'Evidence', top: '10.7%', left: '50%' },
	{ kind: 'interpretation', label: 'Interpretation', top: '30%', left: '84%' },
	{ kind: 'decision', label: 'Decision', top: '70%', left: '84%' },
	{ kind: 'action', label: 'Action', top: '89.3%', left: '50%' },
	{ kind: 'outcome', label: 'Outcome', top: '70%', left: '16%' },
	{ kind: 'new-evidence', label: 'New evidence', top: '30%', left: '16%' },
];
---

<SysScene
	scene="loop"
	label="10 · Resilience"
	quote="The outcome becomes new evidence."
>
	<div class="sys-loop" data-sys-loop>
		<svg
			class="sys-loop__ring"
			viewBox="0 0 300 300"
			fill="none"
			aria-hidden="true"
		>
			<circle cx="150" cy="150" r="118" stroke="var(--color-line)" stroke-dasharray="2 5" />
		</svg>

		<div class="sys-loop__nodes">
			{
				ring.map((n) => (
					<div
						class:list={['sys-node', 'sys-loop__node', `sys-node--${n.kind}`]}
						style={`top: ${n.top}; left: ${n.left}`}
					>
						<span class="sys-node__label">{n.label}</span>
					</div>
				))
			}
		</div>
	</div>

	<div class="sys-loop__center">
		<span class="sys-node__label">Correction stays possible</span>
		<p>Errors can surface, decisions can be reconstructed, and outcomes can guide the next cycle.</p>
	</div>
</SysScene>
